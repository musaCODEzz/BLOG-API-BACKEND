PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=BLOG-API
JWT_SECRET=your_super_secret_jwt_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://blog-api-frontend-neon.vercel.app

# Resend Transactional Email Service
RESEND_API_KEY=re_your_api_key_here
CLIENT_URL=https://blog-api-frontend-neon.vercel.app

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

